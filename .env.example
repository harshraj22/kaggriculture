# Copy to `.env` for local defaults:  cp .env.example .env
#
# Read by tools/ ONLY. `agentlib/` never loads a .env — the agent runs inside
# Kaggle's sandbox where neither the file nor python-dotenv exists, and a config
# channel that behaves differently locally than in a submission is how you ship
# something you never tested.
#
# Real environment variables win over this file, so
#   KAGGRICULTURE_CONFIG=configs/baseline.yaml make eval
# still overrides whatever is set here.
#
# `.env` is gitignored. `.env.example` is not — keep this file secret-free.

# --- which controller runs -----------------------------------------------------

# Config used when a command doesn't pass --config. Note this does NOT decide
# what a SUBMISSION runs: that's configs/active.yaml, set by `make activate`.
# KAGGRICULTURE_CONFIG=configs/safe_only.yaml

# Force a controller type regardless of what the config file says. Handy for
# re-running one config under a different controller without editing it.
# KAGGRICULTURE_CONTROLLER=priority

# Trained policy artifact for `type: rl`. Not implemented yet — the RL
# controller is a documented stub.
# KAGGRICULTURE_POLICY=models/policy.npz

# --- RL data collection --------------------------------------------------------

# Record per-turn (features, action index, eligibility mask) into the journal.
# Prefer `evaluate.py --trajectory`, which sets this for the run and clears it
# afterwards. Setting it here makes every local run pay the cost.
# KAGGRICULTURE_RECORD_TRAJECTORY=1

# --- experiment tracking (Weights & Biases) ------------------------------------

# Mirror every evaluate.py result into W&B without passing --wandb each time.
# Opt-in on purpose: a local `make eval` shouldn't need network or an API key.
# KAGGRICULTURE_WANDB=1

# WANDB_PROJECT=kaggriculture
# WANDB_ENTITY=your-team
# WANDB_MODE=offline      # log locally; `wandb sync wandb/offline-run-*` later
# WANDB_API_KEY=          # SECRET — .env is gitignored, .env.example is not

# --- Kaggle auth ---------------------------------------------------------------

# Alternative to ~/.kaggle/access_token. This is a SECRET: it belongs in .env
# (gitignored), never in .env.example.
# KAGGLE_API_TOKEN=
