# Everything here is either generated, machine-local, or secret.
# Rule of thumb: if a command can recreate it, it doesn't belong in git.

# --- environments -------------------------------------------------------------
.venv/
.venv-linux/
venv/
env/

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- experiment output --------------------------------------------------------
# Runs, trajectories and the W&B sync marker. All regenerable: `make eval-all`
# rebuilds experiments.jsonl, `--trajectory` rebuilds trajectories.
#
# NOTE: this makes W&B the shared record rather than a view over git. Anything
# you want a collaborator to see must be pushed there (`make wandb`), because a
# fresh clone has no results and `make compare` will be empty.
results/

# --- W&B ----------------------------------------------------------------------
# local run cache, including offline runs awaiting sync
wandb/

# NOTE: opponents/ is deliberately TRACKED, not ignored — see opponents/README.md.
# It holds third-party agents we spar against. They are never imported by
# agentlib/; they are only ever passed to env.run() as a file path.

# --- competition artifacts ----------------------------------------------------
# built tarballs — `make bundle` recreates them
submissions/
replays/
logs/
# `kaggle competitions download` output
data/
*.json.gz

# --- generated configs --------------------------------------------------------
# tools/bundle.py compiles configs/*.yaml -> configs/*.json for the submission.
# The YAML is the source; the JSON is a build artifact.
#
# configs/active.yaml is deliberately NOT ignored — it records what the current
# submission plays, which is a decision worth reviewing in a diff.
configs/*.json

# --- secrets ------------------------------------------------------------------
# .env.example IS tracked; keep it secret-free
.env
.kaggle/
kaggle.json
access_token
*.pem
*.key

# --- os / editor --------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
